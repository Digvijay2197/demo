# ============================================================================
#  Recipe RAG backend - configuration
#  Copy this file to  .env  and fill in GROQ_API_KEY. Everything else has a
#  working default; override only what you need.
# ============================================================================

# --- LLM (generation) -------------------------------------------------------
# REQUIRED. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Pick a model your key can access - list them with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Common choices: openai/gpt-oss-20b (fast), openai/gpt-oss-120b (smarter),
# llama-3.3-70b-versatile, llama-3.1-8b-instant. See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
# Reasoning models (gpt-oss, qwen) burn hidden tokens; "low" keeps you under the
# Groq free-tier 8,000 tokens/minute limit. "medium"/"high" for harder tasks.
GROQ_REASONING_EFFORT=low

# --- Embeddings (local, downloaded once on first run, no API key) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector database (ChromaDB, persisted on disk) ------------------------
# Paths are relative to the backend/ folder.
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=recipes

# --- Source documents ----------------------------------------------------
# Drop any text-based recipe PDF(s) here, then: python scripts/ingest.py
PDF_DIR=./data/pdfs
# Auto-index PDFs: on API startup, and whenever a file in PDF_DIR changes while
# the server runs. Set to false to require `python scripts/ingest.py` manually.
AUTO_INGEST_ON_STARTUP=true
WATCH_PDF_DIR=true

# --- Chunking ----------------------------------------------------------
CHUNK_SIZE=550
CHUNK_OVERLAP=80

# --- Retrieval -------------------------------------------------------
TOP_K=4
# Max characters of retrieved context sent to the LLM per question (~4 chars/token).
# Lower this if you hit Groq rate limits on a large multi-recipe PDF.
MAX_CONTEXT_CHARS=4000
# Minimum similarity (1 - cosine distance) for the top hit before the bot
# will answer. Below this it refuses instead of guessing. Observed range:
# on-topic ~0.6-0.8, unrelated question < 0.1.
SIMILARITY_THRESHOLD=0.22

# --- API -----------------------------------------------------------
PORT=8000
# Frontend origin allowed by CORS. The Next.js dev server runs on 3006
# (see frontend/package.json).
CORS_ORIGIN=http://localhost:3006

# --- Quiet third-party noise (optional) --------------------------------
ANONYMIZED_TELEMETRY=False
TOKENIZERS_PARALLELISM=false
HF_HUB_DISABLE_TELEMETRY=1
