# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# This is a monorepo: frontend/ (Next.js) and backend/ (Python/FastAPI).
# Patterns below are unanchored (no leading slash) so they match at any
# depth, since the Node/Next tooling lives under frontend/, not the repo root.

# ---- Node / Next.js (frontend/) ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Python / FastAPI (backend/) ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Generated RAG data (regenerate with backend/scripts/ingest.py) ----
backend/data/vectorstore/

# ---- Env files (never commit secrets; keep .env.example templates) ----
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.pem

# ---- Vercel ----
.vercel
